datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id        String   @id @default(uuid())
  full_name String
  email     String   @unique
  workspaces Workspace[]
  @@map("users")
}

model Workspace {
  id            String   @id @default(uuid())
  name          String
  owner_id      String
  owner         User     @relation(fields: [owner_id], references: [id])
  custom_limits Json?
  nexus_settings Json? // { "email": "..." }

  @@map("workspaces")
}

model SystemSettings {
  key        String   @id
  value      String   // JSON string
  updated_at DateTime @default(now()) @map("updated_at")

  @@map("system_settings")
}

model Plan {
  id          String   @id @default(uuid())
  slug        String   @unique // 'starter', 'pro', etc.
  name        String
  description String?
  price       Float
  limits      Json     // Stores capabilities like { "crm": true, "users": 5 }
  stripe_price_id String?
  is_active   Boolean  @default(true)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("plans")
}
