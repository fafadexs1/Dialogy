{
  "expo": {
    "name": "Dialogy",
    "slug": "dialogy-mobile",
    "scheme": "dialogy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dialogy.mobile"
    },
    "android": {
      "package": "com.dialogy.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#050507"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
