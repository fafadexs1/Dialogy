{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-stripe.cjs",
    "dev:next": "node scripts/dev-with-stripe.cjs --no-stripe",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build --webpack",
    "start": "next start -p 9045",
    "worker": "tsx src/worker.ts",
    "worker:ai": "tsx src/worker-ai.ts",
    "dev:worker": "tsx --watch src/worker.ts",
    "dev:worker:ai": "tsx --watch src/worker-ai.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:ai:build": "node scripts/build-worker-ai.mjs",
    "docker:release": "powershell -ExecutionPolicy Bypass -File scripts/docker-release.ps1",
    "docker:release:dry": "powershell -ExecutionPolicy Bypass -File scripts/docker-release.ps1 -SkipDocker",
    "lint": "next lint",
    "i18n:sync-en": "node scripts/sync-en-us-i18n.mjs",
    "i18n:sync-es": "node scripts/sync-es-es-i18n.mjs",
    "i18n:sync-all": "npm run i18n:sync-en && npm run i18n:sync-es",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:autopilot:quality": "vitest run tests/agent-tool-audit.spec.ts tests/autopilot-e2e-quality-gate.spec.ts tests/autopilot-conversation-e2e.spec.ts tests/autopilot-failure-recovery-matrix.spec.ts tests/autopilot-flow-builder-fallback-capabilities.spec.ts tests/autopilot-flow-layout.spec.ts tests/autopilot-turn-plan.spec.ts tests/sgp-tools-contract-ownership.spec.ts tests/sgp-contact-panel-data.spec.ts tests/wifi-channel-analysis.spec.ts tests/autopilot-turn-policy.spec.ts tests/autopilot-tool-coverage.spec.ts tests/autopilot-tool-planner.spec.ts tests/procedure-runtime.spec.ts tests/autopilot-procedure-tool-reuse.spec.ts tests/mcp-tool-safety.spec.ts tests/mcp-circuit-breaker.spec.ts tests/mcp-store-health.spec.ts tests/mcp-runtime-overrides.spec.ts tests/autopilot-chat-lease.spec.ts tests/autopilot-durable-tool-claim.spec.ts tests/autopilot-response-delivery.spec.ts tests/autopilot-message-sender-delivery.spec.ts tests/autopilot-provider-delivery.spec.ts tests/autopilot-stale-source-guard.spec.ts tests/autopilot-failure-handoff.spec.ts tests/ai-queue-autopilot-failure.spec.ts tests/ai-queue-provider-uncertain.spec.ts tests/evolution-webhook-inbox.spec.ts tests/evolution-api-client-timeout.spec.ts tests/queue-whatsapp-failure.spec.ts",
