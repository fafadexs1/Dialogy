{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-with-stripe.cjs",
    "dev:pwa": "node scripts/dev-with-stripe.cjs --pwa",
    "dev:next": "node scripts/dev-with-stripe.cjs --no-stripe",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start -p 9045",
    "worker": "tsx src/worker.ts",
    "worker:ai": "tsx src/worker-ai.ts",
    "worker:campaign": "tsx src/worker-campaign.ts",
    "worker:meta-relay": "tsx src/worker-meta-relay.ts",
    "worker:google-ads": "tsx src/worker-google-ads.ts",
    "worker:nexus": "tsx src/worker-nexus.ts",
    "dev:worker": "tsx --watch src/worker.ts",
    "dev:worker:ai": "tsx --watch src/worker-ai.ts",
    "dev:worker:campaign": "tsx --watch src/worker-campaign.ts",
    "dev:worker:meta-relay": "tsx --watch src/worker-meta-relay.ts",
    "dev:worker:google-ads": "tsx --watch src/worker-google-ads.ts",
    "dev:worker:nexus": "tsx --watch src/worker-nexus.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:ai:build": "node scripts/build-worker-ai.mjs",
    "worker:campaign:build": "node scripts/build-worker-campaign.mjs",
