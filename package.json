    "lint": "eslint src --cache --cache-location .eslintcache",
    "i18n:sync-en": "node scripts/sync-en-us-i18n.mjs",
    "i18n:sync-es": "node scripts/sync-es-es-i18n.mjs",
    "i18n:sync-all": "npm run i18n:sync-en && npm run i18n:sync-es",
    "typecheck": "next typegen && tsc --noEmit",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "security:audit": "node scripts/check-dependency-audit.mjs",
    "test": "vitest run",
    "test:autopilot:quality": "vitest run tests/agent-tool-audit.spec.ts tests/autopilot-copilot-suggestion.spec.ts tests/autopilot-e2e-quality-gate.spec.ts tests/autopilot-conversation-e2e.spec.ts tests/autopilot-failure-recovery-matrix.spec.ts tests/autopilot-flow-builder-fallback-capabilities.spec.ts tests/autopilot-flow-layout.spec.ts tests/autopilot-turn-plan.spec.ts tests/sgp-tools-contract-ownership.spec.ts tests/sgp-contact-panel-data.spec.ts tests/wifi-channel-analysis.spec.ts tests/autopilot-turn-policy.spec.ts tests/autopilot-tool-coverage.spec.ts tests/autopilot-tool-planner.spec.ts tests/procedure-runtime.spec.ts tests/autopilot-procedure-tool-reuse.spec.ts tests/mcp-tool-safety.spec.ts tests/mcp-circuit-breaker.spec.ts tests/mcp-store-health.spec.ts tests/mcp-runtime-overrides.spec.ts tests/autopilot-chat-lease.spec.ts tests/autopilot-durable-tool-claim.spec.ts tests/autopilot-response-delivery.spec.ts tests/autopilot-message-sender-delivery.spec.ts tests/autopilot-provider-delivery.spec.ts tests/autopilot-stale-source-guard.spec.ts tests/autopilot-failure-handoff.spec.ts tests/ai-queue-autopilot-failure.spec.ts tests/ai-queue-provider-uncertain.spec.ts tests/evolution-webhook-inbox.spec.ts tests/evolution-api-client-timeout.spec.ts tests/queue-whatsapp-failure.spec.ts",
    "test:autopilot:canary": "tsx scripts/verify-autopilot-conversation-canary.ts",
    "test:autopilot:readonly-replay": "tsx scripts/verify-autopilot-readonly-replay.ts",
    "test:workflow:live": "tsx scripts/verify-workflow-runtime-live.ts",
    "test:workflow:models:live": "tsx scripts/evaluate-lm-studio-capabilities-live.ts",
    "workflow:v2:rollout": "tsx scripts/workflow-runtime-v2-rollout.ts",
    "db:migrations:audit": "tsx scripts/reconcile-prisma-migrations.ts",
    "db:migrations:reconcile": "tsx scripts/reconcile-prisma-migrations.ts --apply",
    "db:nexus:migrations": "tsx scripts/apply-nexus-migrations.ts",
    "db:nexus:migrations:apply": "tsx scripts/apply-nexus-migrations.ts --apply",
    "nexus:velpro:validate": "tsx scripts/import-velpro-final-nexus.ts",
    "nexus:velpro:apply": "tsx scripts/import-velpro-final-nexus.ts --apply",
    "diagnose:presence": "tsx scripts/diagnose-presence-parity.ts",
    "diagnose:product-updates": "tsx scripts/diagnose-product-updates.ts",
    "test:ai-providers:live": "tsx scripts/verify-ai-providers-live.ts",
    "e2e:autopilot:canary": "npm run test:autopilot:canary",
    "e2e:autopilot:readonly-replay": "npm run test:autopilot:readonly-replay --",
    "diagnose:mcp": "tsx scripts/diagnose-mcp-connectivity.ts",
    "diagnose:gads": "tsx scripts/diagnose-google-ads-credentials.ts",
    "repair:autopilot:lucas": "tsx scripts/repair-lucas-autopilot-flow.ts",
    "repair:autopilot:lucas:apply": "tsx scripts/repair-lucas-autopilot-flow.ts --apply",
    "eval:autopilot": "tsx scripts/eval-autopilot.ts --offline",
    "autopilot:learn": "tsx scripts/run-autopilot-learning-cycle.ts",
    "benchmark:embeddings": "tsx scripts/benchmark-embeddings.ts",
    "rag:reindex:bge-m3": "tsx scripts/reindex-bge-m3.ts"
  },
