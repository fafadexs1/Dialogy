# Required security configuration. Never commit real values.
PRIVATE_S3_ENDPOINT=https://storage.example.com
PRIVATE_S3_REGION=us-east-1
PRIVATE_S3_ACCESS_KEY_ID=replace-at-deploy
PRIVATE_S3_SECRET_ACCESS_KEY=replace-at-deploy
PRIVATE_S3_BUCKET=dialogy-private
QUEUE_WORKER_TOKEN=replace-with-a-long-random-token

# Comma-separated hostnames; subdomains are accepted, private IPs are always rejected.
MEDIA_PROXY_ALLOWED_HOSTS=cdn.example.com
AUDIO_SOURCE_ALLOWED_HOSTS=cdn.example.com
NEXT_IMAGE_ALLOWED_HOSTS=cdn.example.com
AUDIO_OUTPUT_BUCKET=temp-media
