# =============================================================================
# Dialogy - variaveis de ambiente
#
# O docker-compose.yml NAO usa env_file: ele interpola ${VAR} a partir do
# .env que estiver NO MESMO DIRETORIO do compose. Sem esse arquivo ao lado
# do docker-compose.yml, toda variavel vira string vazia no deploy.
#
# Copie para .env e preencha. Nunca versione o .env preenchido.
# =============================================================================


# =============================================================================
# OBRIGATORIAS (40) - sem default no compose. Vazias quebram o deploy.
# =============================================================================

# --- Banco de dados
DATABASE_URL=

# --- Evolution API
EVOLUTION_BUSINESS_FIELD_MAX_LENGTH=
EVOLUTION_INSTANCE_TOKEN_MAX_LENGTH=
EVOLUTION_LIVE_EVENT_MAX_AGE_SECONDS=
EVOLUTION_WEBHOOK_CONCURRENCY=

# --- Fila e workers
QUEUE_WORKER_TOKEN=
REDIS_PASSWORD=
REDIS_URL=

# --- Geral
ALLOW_DANGEROUS_ADMIN_OPERATIONS=
DIALOGY_INTERNAL_SECRET=
WEBHOOK_TIMEOUT_MS=

# --- Meta (Facebook/Instagram/WhatsApp Cloud)
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_SECRET=
META_APP_SECRET=
# Chave AES-GCM para credenciais reutilizáveis de automação (mínimo 32 caracteres).
# Se ausente, o runtime usa META_PAYLOAD_ENCRYPTION_KEY durante a transição.
WORKSPACE_CREDENTIALS_ENCRYPTION_KEY=
NEXUS_SCHEDULE_ENABLED=true
NEXUS_SCHEDULE_POLL_MS=30000
NEXUS_SCHEDULE_CATCHUP_MINUTES=1440
# Monitor nativo: http://127.0.0.1:9050/health, /status e /metrics
NEXUS_MONITOR_PORT=9050
NEXUS_MONITOR_POLL_MS=30000
NEXUS_DB_POOL_MAX=1
META_VERIFY_TOKEN=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_INSTAGRAM_APP_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# --- Midia e storage
AUDIO_SOURCE_ALLOWED_HOSTS=
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_PROXY_ALLOWED_HOSTS=
PRIVATE_S3_ACCESS_KEY_ID=
PRIVATE_S3_BUCKET=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_SECRET_ACCESS_KEY=

# --- Supabase
# Client-side/SSR-safe key only: anon JWT or sb_publishable_*. Never put
# service_role or sb_secret_* in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URLs e dominios
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_NSXD_URL=
# NEXT_PUBLIC_PWA_DEV=1 enables the PWA during local Turbopack development.
NEXT_PUBLIC_SITE_URL=
NEXTAUTH_URL=
# Public Dialogy origin for Evolution -> Dialogy delivery. Overrides NEXTAUTH_URL,
# which local development may replace with localhost (unreachable by remote Evolution).
EVOLUTION_WEBHOOK_BASE_URL=
NSXD_URL=


# =============================================================================
# OPCIONAIS (130) - o compose ja aplica o default mostrado.
# Descomente apenas para sobrescrever.
# =============================================================================

