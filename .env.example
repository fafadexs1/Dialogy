# MCP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=2
# MCP_CIRCUIT_BREAKER_FAILURE_WINDOW_MS=300000
# MCP_CIRCUIT_BREAKER_OPEN_MS=60000
# MCP_TOOL_TIMEOUT_MS=30000

# --- Meta (Facebook/Instagram/WhatsApp Cloud)
# META_APP_ID=
# META_APP_SECRETS=
# META_PAYLOAD_ENCRYPTION_KEY=
# META_RELAY_CONCURRENCY=
# META_RELAY_TIMEOUT_MS=
# META_WHATSAPP_VERIFY_TOKEN=

# --- Midia e storage
# AI_MEDIA_ANALYSIS_TIMEOUT_MS=12000
# PRIVATE_S3_REGION=us-east-1

# --- Supabase
# SUPABASE_SECRET=
# SUPABASE_URL=

# --- URLs e dominios
# POSTGRES_URL=
# WHISPER_BASE_URL=${BASE_URL:-

# ASAAS: use sandbox for validation; never expose these as NEXT_PUBLIC_ variables.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# At least 32 random characters; required to save encrypted credentials in superadmin.
ASAAS_ENCRYPTION_KEY=

# Nexus automation toolbox: opt in workspace IDs after applying its migration.
# Empty means disabled in production. Development is enabled by default.
# NEXUS_AUTOMATION_WORKSPACES=workspace-uuid,another-workspace-uuid

# Protected distribution: apply its additive migration before deploying.
CHAT_DISTRIBUTION_MODE=legacy
CHAT_DISTRIBUTION_WORKSPACES=
CHAT_DISTRIBUTION_ROLLOUT=100

# Google Workspace OAuth: registre /api/integrations/google-workspace/callback em NEXTAUTH_URL.
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=

# OAuth Apps: registre os callbacks /api/integrations/app-oauth/github/callback e /api/integrations/app-oauth/notion/callback.
# GITHUB_APPS_CLIENT_ID=
# GITHUB_APPS_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
## Encerramento explícito do Estúdio: só encerra o chat quando o cliente confirma (ids de agentes separados por vírgula, ou *).
## Vazio mantém o comportamento anterior. Aplicar no app e no worker de IA com o mesmo valor.
# STUDIO_EXPLICIT_CLOSE_AGENT_IDS=
## Transferência imediata, sem esperar o modelo, quando o cliente pede uma pessoa (ids de agentes ou *).
# STUDIO_HUMAN_REQUEST_GUARD_AGENT_IDS=
## Validador de promessas: off | observe (padrão: só registra no ledger) | enforce (remove a frase sem lastro antes de enviar).
# STUDIO_PROMISE_GUARD=observe
## Vigilante de inatividade (roda no worker): aviso, espera e encerramento com base inatividade_pos_followup.
## Vazio desliga. Esperas têm piso de 10 minutos; só age dentro da janela (hora local).
# STUDIO_INACTIVITY_AGENT_IDS=
# STUDIO_INACTIVITY_FOLLOWUP_MINUTES=30
# STUDIO_INACTIVITY_CLOSE_MINUTES=30
# STUDIO_INACTIVITY_WINDOW=8-21
# STUDIO_INACTIVITY_TZ=America/Sao_Paulo
## SLA da fila de transferência (roda no worker). Chats enfileirados por "fora do expediente" não entram.
# QUEUE_SLA_ENABLED=false
# QUEUE_SLA_MINUTES=10
# QUEUE_SLA_ESCALATE_MINUTES=20
# QUEUE_SLA_ESCALATION_TEAM_ID=
# QUEUE_SLA_ALERT_WEBHOOK_URL=
## Memória de resultados das integrações (0 mantém até exclusão manual).
STUDIO_TOOL_MEMORY_RETENTION_DAYS=0
STUDIO_TOOL_MEMORY_MAX_PER_TOOL=0

# Opcional: imagem local preparada com scripts/agent-sandbox.Dockerfile.
# O processo da aplicação precisa acessar um daemon Docker isolado e confiável.
DIALOGY_AGENT_SANDBOX_IMAGE=

# Opcional: conversor sem rede de documentos DOC/XLS (scripts/agent-legacy-office.Dockerfile).
# Necessário tanto no processo web de importação quanto no worker que lê arquivos.
DIALOGY_LEGACY_OFFICE_IMAGE=

# Opcional: habilita JavaScript apenas no navegador isolado sem rede.
DIALOGY_AGENT_BROWSER_JS=false

# Opcional: pesquisa web direta pelo Parallel Search (tem precedência sobre o endpoint genérico).
PARALLEL_API_KEY=

# Serviços opcionais alternativos: configure apenas endpoints HTTPS confiáveis.
DIALOGY_AGENT_SEARCH_ENDPOINT=
DIALOGY_AGENT_SEARCH_TOKEN=
DIALOGY_AGENT_SANDBOX_ENDPOINT=
DIALOGY_AGENT_SANDBOX_TOKEN=
# Ative somente depois de validar o isolamento real do serviço remoto.
DIALOGY_AGENT_SANDBOX_ISOLATED=false
DIALOGY_AGENT_MEDIA_ENDPOINT=
DIALOGY_AGENT_MEDIA_TOKEN=

# Imagens Docker locais opcionais; veja docs/agent-native-external-tools.md.
DIALOGY_AGENT_BROWSER_IMAGE=
DIALOGY_AGENT_VIDEO_IMAGE=

# Geração de imagens OpenAI usa o modelo e faturamento configurados na IA Global.
DIALOGY_AGENT_IMAGE_PROVIDER=
DIALOGY_AGENT_OPENAI_IMAGE_MODEL=
